# Neon: Project -> Connect -> turn OFF "Connection pooling" -> copy the connection string.
# Use the DIRECT (non-pooled) URL: migrations take a session-level advisory lock and
# the tests pin a search_path, neither of which survives PgBouncer.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- optional; defaults shown ---
API_ADDR=:8080

# Where the worker posts vouchers (the mock accounting server).
ACCOUNTING_URL=http://localhost:9090
ACCOUNTING_TIMEOUT=3s        # per-request timeout; must be shorter than WORKER_LEASE
WORKER_CONCURRENCY=8         # vouchers in flight at once
WORKER_MAX_ATTEMPTS=5        # attempts before a voucher ends "failed"
WORKER_BACKOFF_BASE=1s
WORKER_BACKOFF_MAX=30s
WORKER_LEASE=15s

# Mock accounting server misbehaviour.
MOCK_ADDR=:9090
MOCK_FAIL_RATE=0.2           # HTTP 500
MOCK_HANG_RATE=0.1           # hang MOCK_HANG_FOR, then succeed
MOCK_HANG_FOR=5s

# Next.js proxies /backend/* to the Go API.
API_URL=http://localhost:8080
